Prefix(:=<http://ex.org/>) Prefix(obo:=<http://purl.obolibrary.org/obo/>)
Ontology(<http://ex.org/chain>
  Declaration(ObjectProperty(:starts_at_end_of))   # a LOCAL stand-in for Allen M (see 06/07)
  Declaration(ObjectProperty(:starts_strictly_after))                      # -- Allen P

  # THE TEMPORAL INFERENCE:  M o M = P
  # if x starts when y ends, and y starts when z ends, then x starts strictly after z ends
  SubObjectPropertyOf(ObjectPropertyChain(:starts_at_end_of :starts_at_end_of) :starts_strictly_after)
  TransitiveObjectProperty(:starts_strictly_after)

  Declaration(NamedIndividual(:hepatic_plate))
  Declaration(NamedIndividual(:hepatic_diverticulum))
  Declaration(NamedIndividual(:liver))
  Declaration(NamedIndividual(:gall_bladder))

  # the real EHDAA2 chain:  hepatic plate -> hepatic diverticulum -> liver
  ObjectPropertyAssertion(:starts_at_end_of :hepatic_diverticulum :hepatic_plate)
  ObjectPropertyAssertion(:starts_at_end_of :liver :hepatic_diverticulum)
  ObjectPropertyAssertion(:starts_at_end_of :gall_bladder :liver)
)
